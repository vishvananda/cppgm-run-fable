void clear_bytes(char *p, unsigned long n) {
  __builtin_bzero(p, n);
}

int main()
{
  char buf[8];
  for (unsigned i = 0; i < sizeof(buf); ++i)
    buf[i] = (char)(i + 1);
  clear_bytes(buf, sizeof(buf));
  for (unsigned i = 0; i < sizeof(buf); ++i)
    if (buf[i] != 0)
      return 1;
  return 0;
}
