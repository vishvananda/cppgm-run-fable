int destroyed = 0;

struct CleanupError
{
};

struct Guard
{
  ~Guard()
  {
    ++destroyed;
  }
};

void boom()
{
  throw CleanupError();
}

void middle()
{
  Guard guard;
  boom();
}

int main()
{
  try
  {
    middle();
  }
  catch (const CleanupError &)
  {
    return destroyed == 1 ? 0 : 2;
  }
  return 1;
}
