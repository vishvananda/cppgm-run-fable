function @instantiate_standard_owner() -> void [binding=strong, object=_Z26instantiate_standard_ownerv] {
  slot $traits : obj<1x1>

  block ^entry:
    %t1 = addr $traits
    %t2 = addr $traits
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    call void @instantiate_standard_owner()
    return i32 0
}
