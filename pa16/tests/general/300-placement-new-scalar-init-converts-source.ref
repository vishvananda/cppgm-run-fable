function @operatornew(%__param0 : i64, %p : ptr) -> ptr [binding=strong, object=_ZnwmPv] {
  slot $__param0 : i64
  slot $p : ptr

  block ^entry:
    store i64 %__param0, $__param0
    store ptr %p, $p
    %t1 = load ptr $p
    return ptr %t1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $f : f32
  slot $i : i32

  block ^entry:
    store f32 0.0f, $f
    store i32 7, $i
    %t1 = convert sext i64 i32 4
    %t2 = addr $f
    %t3 = call ptr @operatornew(%t1, %t2)
    %t4 = load i32 $i
    %t5 = convert sitofp f32 i32 %t4
    store f32 %t5, %t3
    return i32 0
}
