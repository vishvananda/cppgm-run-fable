#include <cstdio>
#include <string>

std::string flat()
{
	return std::string("member-name-spelling-long");
}

std::string build(bool have, bool definition)
{
	return std::string(definition ? "special-member-definition "
	                              : "special-member-declaration ") +
	       (have ? flat() : std::string());
}

int main()
{
	std::string a = build(true, true);
	std::string b = build(false, false);
	std::printf("%s|%s\n", a.c_str(), b.c_str());
	return 0;
}
