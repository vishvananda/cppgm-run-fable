function @main() -> i32 [role=entry, unwind=no, binding=strong, keep_alias=yes] {
  slot $a : i32
  slot $b : i32
  slot $v : u8
  slot $w : u8
  slot $r : obj<8x8>
  slot $argobj__1 : obj<8x8>
  slot $cond__2 : i32
  slot $land__3 : i64
  slot $land__4 : i64
  slot $land__5 : i64

  block ^entry:
    store i32 1, $a
    store i32 2, $b
    %t1 = addr $a
    %t2 = addr $b
    call void @n__swap_int_(%t1, %t2)
    store u8 0, $v
    store u8 1, $w
    %t3 = addr $r
    %t4 = addr $v
    %t5 = addr $r
    %t6 = index i8 [projection=field] %t5, 0
    store ptr %t4, %t6
    %t7 = addr $argobj__1
    %t8 = addr $r
    copyobj 8x8 %t8, %t7
