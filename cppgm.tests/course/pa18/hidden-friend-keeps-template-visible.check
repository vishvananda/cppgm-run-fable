  block ^cond_end_3:
    %t23 = load i32 $cond__2
    return i32 %t23
}
function @n__swap__ov2(%x : obj<8x8>, %y : ptr [pass=reference]) -> void [unwind=no, binding=weak, object=_ZN1n4swapENS_2BRERb] {
  slot $x : obj<8x8>
  slot $y : ptr
  slot $t : u8

  block ^entry:
    %t1 = addr $x
    copyobj 8x8 %x, %t1
    store ptr %y, $y
    %t2 = addr $x
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = load ptr %t3
    %t5 = load u8 %t4
    store u8 %t5, $t
    %t6 = load ptr $y
    %t7 = load u8 %t6
    %t8 = addr $x
    %t9 = index i8 [projection=field] %t8, 0
    %t10 = load ptr %t9
    store u8 %t7, %t10
    %t11 = load u8 $t
    %t12 = load ptr $y
    store u8 %t11, %t12
    return void
}
function @n__swap_int_(%a : ptr [pass=reference], %b : ptr [pass=reference]) -> void [unwind=no, binding=weak, object=_ZN1n4swapIiEEvRT_S2_] {
  slot $a : ptr
  slot $b : ptr
