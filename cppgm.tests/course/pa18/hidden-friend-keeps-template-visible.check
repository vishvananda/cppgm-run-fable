    call void @n__swap__ov2($argobj__1, %t9)
    %t10 = load i32 $a
    %t11 = cmp eq i32 %t10, 2
    branch %t11, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t12 = load i32 $b
    %t13 = cmp eq i32 %t12, 1
    %t14 = cmp ne i64 %t13, 0
    store i64 %t14, $land__5
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__5
    jump ^land_end_12

  block ^land_end_12:
    %t15 = load i64 $land__5
    branch %t15, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t16 = load u8 $v
    %t17 = cmp ne i64 %t16, 0
    store i64 %t17, $land__4
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__4
    jump ^land_end_9

  block ^land_end_9:
    %t18 = load i64 $land__4
    branch %t18, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t19 = load u8 $w
    %t20 = cmp eq i64 %t19, 0
    %t21 = cmp ne i64 %t20, 0
    store i64 %t21, $land__3
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__3
    jump ^land_end_6

  block ^land_end_6:
    %t22 = load i64 $land__3
    branch %t22, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__2
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__2
