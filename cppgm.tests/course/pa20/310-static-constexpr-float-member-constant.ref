declare global @Consts__scale : f64 [binding=strong, object=_ZN6Consts5scaleE]

function @scale() -> f64 [binding=strong, object=_Z5scalev] {
  block ^entry:
    %t1 = load f64 @Consts__scale
    return f64 %t1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call f64 @scale()
    %t2 = cmp eq f64 %t1, 2.5
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load i32 $cond__1
    return i32 %t3
}
